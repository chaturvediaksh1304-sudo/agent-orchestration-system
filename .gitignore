# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Runtime state: task history lives in Postgres, but conversation memory,
# checkpoints, and any cached auth token land here.
.orchestration/

# Subagent scratch space
workspace/

# Local secrets — never commit
.env
*.token
token.json

# Local editor/tool config
.claude/settings.local.json

# macOS
.DS_Store

# GAIA benchmark: per-task results hold ground-truth answers, which GAIA's
# terms forbid resharing. Only the harness and the aggregate report are tracked.
results/
results-*/
*.parquet
gaia-test/
bench-state/

# Session handoff notes (personal context, not project docs)
bench/CONTEXT.md
